<Window x:Class="MovieTracker.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movie Tracker"
        Width="365" Height="198"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- High-Contrast Smoked Glass Input Style -->
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#EA1C2430"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#664C5E72"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#00FF66"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6A7C8E"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Card Container: Compact Smoked Glass + Animated Illuminated Border -->
    <Border x:Name="MainCard" Margin="14" CornerRadius="12" BorderThickness="1.8">
        <!-- Smoked Dark Glass Background: blocks background clutter while keeping glass depth -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EB151C25" Offset="0.0"/>
                <GradientStop Color="#DA0D1219" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <!-- Hyper-Bright Illuminated Neon Border -->
        <Border.BorderBrush>
            <LinearGradientBrush x:Name="AnimatedBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <LinearGradientBrush.RelativeTransform>
                    <RotateTransform x:Name="BorderGlowAngle" CenterX="0.5" CenterY="0.5" Angle="0"/>
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#00FF66" Offset="0.0"/>
                <GradientStop Color="#00F7FF" Offset="0.28"/>
                <GradientStop Color="#B388FF" Offset="0.58"/>
                <GradientStop Color="#00F7FF" Offset="0.82"/>
                <GradientStop Color="#00FF66" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <!-- Seamless Ambient Halo (Diffuses completely into 100% transparency) -->
        <Border.Effect>
            <DropShadowEffect x:Name="OuterGlow"
                              BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.8"
                              Color="#00FF77"/>
        </Border.Effect>

        <Grid>
            <!-- Top Specular Glass Reflection Sheen -->
            <Border Height="1" VerticalAlignment="Top" Margin="10,1,10,0" Opacity="0.4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0.0"/>
                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="10,8,10,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0: Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1: Editable Title input -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: Metadata: Year, Season, Episode, Date -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3: Rating -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4: Actions -->
                    <RowDefinition Height="Auto"/>
                    <!-- 5: Progress bar -->
                </Grid.RowDefinitions>

                <!-- Header: Glass source badge + Duration + Close -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#3500E054" BorderBrush="#6500FF66" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtSourceBadge" Text="🎬 Media Detected" Foreground="#00FF66" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="TxtDuration" Text="" Foreground="#A4B8CC" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="✕" HorizontalAlignment="Right" Foreground="#A4B8CC" Background="Transparent"
                            BorderThickness="0" FontSize="12" Cursor="Hand" Click="BtnDismiss_Click" Padding="4,0"/>
                </Grid>

                <!-- Editable Movie / Show Title Field -->
                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <TextBox x:Name="TxtTitle" Height="24" Style="{StaticResource GlassTextBox}" ToolTip="Click to edit Title" FontSize="11.5"/>
                </Grid>

                <!-- Metadata Row: Year | Season | Episode | Watched Date -->
                <Grid Grid.Row="2" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <!-- Year -->
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="42"/>
                        <!-- Season -->
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="42"/>
                        <!-- Episode -->
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <!-- Date -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Year" Foreground="#A4B8CC" FontSize="8.5" FontWeight="Medium" Margin="1,0,0,1"/>
                        <TextBox x:Name="TxtYear" Height="22" Style="{StaticResource GlassTextBox}" ToolTip="Release Year"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Season" Foreground="#A4B8CC" FontSize="8.5" FontWeight="Medium" Margin="1,0,0,1"/>
                        <TextBox x:Name="TxtSeason" Height="22" Style="{StaticResource GlassTextBox}" ToolTip="Season (empty for movie)"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Episode" Foreground="#A4B8CC" FontSize="8.5" FontWeight="Medium" Margin="1,0,0,1"/>
                        <TextBox x:Name="TxtEpisode" Height="22" Style="{StaticResource GlassTextBox}" ToolTip="Episode (empty for movie)"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Watched Date" Foreground="#A4B8CC" FontSize="8.5" FontWeight="Medium" Margin="1,0,0,1"/>
                        <TextBox x:Name="TxtDate" Height="22" Style="{StaticResource GlassTextBox}" ToolTip="Watched Date (YYYY-MM-DD)"/>
                    </StackPanel>
                </Grid>

                <!-- Star Rating (1 to 5) -->
                <Grid Grid.Row="3" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Rating:" Foreground="#A4B8CC" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button x:Name="Star1" Content="★" Style="{StaticResource StarBtnStyle}" Click="Star_Click" Tag="1"/>
                        <Button x:Name="Star2" Content="★" Style="{StaticResource StarBtnStyle}" Click="Star_Click" Tag="2"/>
                        <Button x:Name="Star3" Content="★" Style="{StaticResource StarBtnStyle}" Click="Star_Click" Tag="3"/>
                        <Button x:Name="Star4" Content="★" Style="{StaticResource StarBtnStyle}" Click="Star_Click" Tag="4"/>
                        <Button x:Name="Star5" Content="★" Style="{StaticResource StarBtnStyle}" Click="Star_Click" Tag="5"/>
                        <TextBlock x:Name="TxtRatingVal" Text="" Foreground="#00FF66" FontSize="10.5" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Actions: Save & Dismiss -->
                <Grid Grid.Row="4" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnSave" Grid.Column="0" Content="Log to Diary" Background="#00E054" Foreground="#08140B"
                            FontWeight="Bold" FontSize="11" Height="26" Cursor="Hand" Click="BtnSave_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="2" Content="Dismiss" Background="#D5202833" Foreground="#D5E2EE"
                            BorderBrush="#664C5E72" BorderThickness="1"
                            FontSize="10.5" Height="26" Padding="12,0" Cursor="Hand" Click="BtnDismiss_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Auto-dismiss subtle countdown bar -->
                <ProgressBar Grid.Row="5" x:Name="ProgressDismiss" Height="2" Minimum="0" Maximum="100" Value="100"
                             Foreground="#00FF66" Background="#33000000" BorderThickness="0" Margin="0,3,0,-3"/>
            </Grid>
        </Grid>
    </Border>
</Window>